# Supabase sync (optional). Copy this file to .env.local and fill both values from
# your Supabase project (Project Settings → API). Leave them empty to run local-only.
# Both values are public by design; Row Level Security protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The pre-sale site's address, e.g. https://example.ca (no trailing path). Settings links to its
# privacy policy and terms. Leave it empty until the domain exists: the links stay hidden.
VITE_SITE_URL=

# The support address for "Write to us" (Settings → About and the crash screen), e.g. aide@example.ca.
# Leave it empty until it exists: the link stays hidden.
VITE_SUPPORT_EMAIL=
# Google / Apple sign-in, once set up in Supabase (docs/SIGNIN_SETUP.md): e.g. google,apple. Empty: email code only.
VITE_AUTH_PROVIDERS=
# Where the app is served: /cadence/ (default; the old address and dev) or /app/ (rebalanceweek.com, set by the site's deploy).
VITE_BASE=
# The old address's build only: where Rebalance lives now, e.g. https://rebalanceweek.com/app/. Empty: no move card.
VITE_MOVED_TO=
# The old addresses the new one accepts weeks from (comma-separated origins). Empty: https://malinovent.github.io.
VITE_HANDOFF_FROM=

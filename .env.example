# Supabase sync (optional). Copy this file to .env.local and fill both values from
# your Supabase project (Project Settings → API). Leave them empty to run local-only.
# Both values are public by design; Row Level Security protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The pre-sale site's address, e.g. https://example.ca (no trailing path). Settings links to its
# privacy policy and terms. Leave it empty until the domain exists: the links stay hidden.
VITE_SITE_URL=

# The support address for "Write to us" (Settings → About and the crash screen), e.g. aide@example.ca.
# Leave it empty until it exists: the link stays hidden.
VITE_SUPPORT_EMAIL=
